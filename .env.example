# 阶段 0 B07：环境配置模板（复制为 .env 后按环境修改，.env 不入库）
# 对齐 05 工程流程四章：.env.example 为唯一配置模板。

# ---- PostgreSQL ----
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=duanju
POSTGRES_PASSWORD=duanju_dev_pwd
POSTGRES_DB=duanju

# 后端 DSN（cmd/migrate 与 api 共用；sslmode=disable 仅限本地开发）
DATABASE_URL=postgres://duanju:duanju_dev_pwd@127.0.0.1:5432/duanju?sslmode=disable

# ---- Redis（宿主 6380；本机 WSL 内已有服务占用 6379，故避让） ----
REDIS_ADDR=127.0.0.1:6380
REDIS_PASSWORD=
REDIS_DB=0

# ---- MinIO / S3 ----
S3_ENDPOINT=127.0.0.1:9000
S3_ACCESS_KEY=duanju
S3_SECRET_KEY=duanju_dev_pwd
S3_BUCKET=duanju
S3_USE_SSL=false

# ---- 应用（宿主 8080；本机已有容器占用 8000，故避让） ----
APP_ENV=dev
APP_PORT=8080
JWT_SECRET=dev-only-secret-change-in-prod
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=168h
