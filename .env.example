# 阶段 0 B07：环境配置模板（复制为 .env 后按环境修改，.env 不入库）
# 对齐 05 工程流程四章：.env.example 为唯一配置模板。

# ---- PostgreSQL ----
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=duanju
POSTGRES_PASSWORD=duanju_dev_pwd
POSTGRES_DB=duanju

# 后端 DSN（cmd/migrate 与 api 共用；sslmode=disable 仅限本地开发）
DATABASE_URL=postgres://duanju:duanju_dev_pwd@127.0.0.1:5432/duanju?sslmode=disable

# ---- Redis（宿主 6380；本机 WSL 内已有服务占用 6379，故避让） ----
REDIS_ADDR=127.0.0.1:6380
REDIS_PASSWORD=
REDIS_DB=0

# ---- MinIO / S3 ----
S3_ENDPOINT=127.0.0.1:9000
S3_ACCESS_KEY=duanju
S3_SECRET_KEY=duanju_dev_pwd
S3_BUCKET=duanju
S3_USE_SSL=false

# ---- 应用（宿主 8080；本机已有容器占用 8000，故避让） ----
APP_ENV=dev
APP_PORT=8080
JWT_SECRET=dev-only-secret-change-in-prod
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=168h

# ---- 支付（08 审查 Critical#1 修复后：生产必须配置 RSA2 公钥，否则拒绝启动） ----
# ALIPAY_APP_ID=支付宝应用 ID
# ALIPAY_PUBLIC_KEY=支付宝 RSA2 验签公钥（PEM 全文或裸 base64 均可；生产必填）
# ALIPAY_USE_MOCK=false（生产强制 false；开发默认 true 走沙箱 HMAC）
# ALIPAY_MOCK_SECRET=开发沙箱 HMAC 密钥（仅开发用）

# ---- CORS 跨域白名单（R1 修复后：生产环境必填，dev 自动允许 localhost） ----
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173 （逗号分隔，生产替换为真实域名）

# ---- 模型密钥加密主密钥（R10 修复后：生产环境必填，防止回退 JWT_SECRET） ----
MODEL_KEY_ENC_SECRET=prod-model-key-enc-secret-change-in-production-at-least-32-chars-long

# ---- Webhook 回调加密密钥（M18 修复后：生产环境必填，AES-GCM 主密钥） ----
WEBHOOK_ENC_SECRET=prod-webhook-enc-secret-change-in-production-at-least-32-chars-long
